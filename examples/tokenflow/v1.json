  "narrative": [
    {
      "stage": "1-import",
      "title": "初始导入与基线核对",
      "detail": "流程建模小组导入 place、transition、加权 arc、初始 marking 与容量约束；审阅者核对节点身份、arc 权重、初始 token、容量、探索策略(bfs)与截断预算(8)均已版本化；p_diag 容量 N/A 与 a21 权重 NaN 无法转换，保留原位并附诊断，绝不因画图而丢弃。"
    },
    {
      "stage": "2-boundary",
      "title": "边界组合触发",
      "detail": "自环(t_selfloop)、并发(t_a/t_b 汇合)、容量边界(p_sink cap=3)、抑制 arc(p_gate -o t_fill)、无界增长(t_grow/p_grow)、相同图不同 marking(m_deadlock)与预算截断(budget=8)逐一重放；每次留下输入片段、判定状态与受影响对象。"
    },
    {
      "stage": "3-enablement",
      "title": "enablement 与多候选",
      "detail": "enablement 同时考虑输入、抑制与容量；状态 canonicalization 不合并 token 不同的 marking；预算耗尽返回 unknown 并保留 frontier；无法唯一决定时保留全部合法候选(如 t_a/t_b 的不同交织)。"
    },
    {
      "stage": "4-review",
      "title": "复核与裁定",
      "detail": "在页面查看网络图、marking 路径、覆盖关系、死锁原因与被截断 frontier；接受/否定/参数调整均生成新事件，可撤销，回到旧事件恢复当时依赖版本与可见结论。"
    }
  ]
